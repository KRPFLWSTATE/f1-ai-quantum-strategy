{
  "$defs": {
    "AuthorizationConfig": {
      "additionalProperties": false,
      "properties": {
        "allowed_plans": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Plans",
          "type": "array"
        },
        "github_push_authorized": {
          "const": false,
          "default": false,
          "title": "Github Push Authorized",
          "type": "boolean"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "allowed_plans"
      ],
      "title": "AuthorizationConfig",
      "type": "object"
    },
    "DossierRef": {
      "additionalProperties": false,
      "properties": {
        "dated": {
          "title": "Dated",
          "type": "string"
        },
        "page_count": {
          "minimum": 1,
          "title": "Page Count",
          "type": "integer"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "dated",
        "relative_path",
        "sha256",
        "page_count"
      ],
      "title": "DossierRef",
      "type": "object"
    },
    "PathConfig": {
      "additionalProperties": false,
      "properties": {
        "evidence_dir": {
          "title": "Evidence Dir",
          "type": "string"
        },
        "ledger_relpath": {
          "title": "Ledger Relpath",
          "type": "string"
        }
      },
      "required": [
        "evidence_dir",
        "ledger_relpath"
      ],
      "title": "PathConfig",
      "type": "object"
    },
    "PythonConfig": {
      "additionalProperties": false,
      "properties": {
        "requires": {
          "title": "Requires",
          "type": "string"
        },
        "selected": {
          "title": "Selected",
          "type": "string"
        }
      },
      "required": [
        "requires",
        "selected"
      ],
      "title": "PythonConfig",
      "type": "object"
    },
    "QPUDraft": {
      "additionalProperties": false,
      "properties": {
        "campaign_ceiling_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Campaign Ceiling Seconds"
        },
        "campaign_ceiling_seconds_reason": {
          "title": "Campaign Ceiling Seconds Reason",
          "type": "string"
        },
        "protected_reserve_seconds": {
          "minimum": 0,
          "title": "Protected Reserve Seconds",
          "type": "integer"
        },
        "provider": {
          "const": "ibm",
          "default": "ibm",
          "title": "Provider",
          "type": "string"
        },
        "reported_balance_seconds": {
          "minimum": 0,
          "title": "Reported Balance Seconds",
          "type": "integer"
        },
        "reported_balance_status": {
          "const": "unverified",
          "default": "unverified",
          "title": "Reported Balance Status",
          "type": "string"
        },
        "submission_path_implemented": {
          "const": false,
          "default": false,
          "title": "Submission Path Implemented",
          "type": "boolean"
        },
        "verified_available_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified Available Seconds"
        },
        "verified_available_seconds_reason": {
          "title": "Verified Available Seconds Reason",
          "type": "string"
        }
      },
      "required": [
        "reported_balance_seconds",
        "verified_available_seconds_reason",
        "protected_reserve_seconds",
        "campaign_ceiling_seconds_reason"
      ],
      "title": "QPUDraft",
      "type": "object"
    },
    "UnresolvedField": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value",
          "type": "null"
        }
      },
      "required": [
        "field",
        "reason"
      ],
      "title": "UnresolvedField",
      "type": "object"
    },
    "WorkerDefaults": {
      "additionalProperties": false,
      "properties": {
        "max_workers": {
          "maximum": 2,
          "minimum": 1,
          "title": "Max Workers",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "max_workers",
        "reason"
      ],
      "title": "WorkerDefaults",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "active_stage": {
      "const": 1,
      "default": 1,
      "title": "Active Stage",
      "type": "integer"
    },
    "authorization": {
      "$ref": "#/$defs/AuthorizationConfig"
    },
    "dossier": {
      "$ref": "#/$defs/DossierRef"
    },
    "hardware_execution_enabled": {
      "const": false,
      "default": false,
      "title": "Hardware Execution Enabled",
      "type": "boolean"
    },
    "mode": {
      "const": "local",
      "default": "local",
      "title": "Mode",
      "type": "string"
    },
    "paths": {
      "$ref": "#/$defs/PathConfig"
    },
    "project_name": {
      "const": "f1-ai-quantum-strategy",
      "default": "f1-ai-quantum-strategy",
      "title": "Project Name",
      "type": "string"
    },
    "protocol_frozen": {
      "const": false,
      "default": false,
      "title": "Protocol Frozen",
      "type": "boolean"
    },
    "python": {
      "$ref": "#/$defs/PythonConfig"
    },
    "qpu": {
      "$ref": "#/$defs/QPUDraft"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scientific_protocol_status": {
      "const": "DRAFT",
      "default": "DRAFT",
      "title": "Scientific Protocol Status",
      "type": "string"
    },
    "unresolved": {
      "items": {
        "$ref": "#/$defs/UnresolvedField"
      },
      "title": "Unresolved",
      "type": "array"
    },
    "workers": {
      "$ref": "#/$defs/WorkerDefaults"
    },
    "zero_additional_spending": {
      "const": true,
      "default": true,
      "title": "Zero Additional Spending",
      "type": "boolean"
    }
  },
  "required": [
    "dossier",
    "qpu",
    "workers",
    "paths",
    "python",
    "unresolved",
    "authorization"
  ],
  "title": "ProjectConfig",
  "type": "object"
}
